# PostgreSQL connection string.
DATABASE_URL=postgres://onion:onionpass@localhost:5432/onion
# JWT signing secret; replace this value before any non-local deployment.
JWT_SECRET=change-me-in-production
# Address where the HTTP and WebSocket server listens.
HOST=0.0.0.0
# HTTP and WebSocket listen port, between 1 and 65535.
PORT=3000
# Runtime environment: development, test, or production.
NODE_ENV=development
# Server logging level: debug, info, warn, or error.
LOG_LEVEL=info
# Directory containing scenario JSON files.
SCENARIOS_DIR=./scenarios

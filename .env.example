# PostgreSQL connection string.
DATABASE_URL=postgres://onion:onionpass@localhost:5432/onion
# JWT signing secret, at least 32 characters; replace this example before deployment.
JWT_SECRET=orgres are like onions, but not at all like parfait, despite what donkey says
# Address where the HTTP and WebSocket server listens.
HOST=0.0.0.0
# HTTP and WebSocket listen port, between 1 and 65535.
PORT=3000
# Runtime environment: development, test, or production.
NODE_ENV=development
# Server logging level: debug, info, warn, or error.
LOG_LEVEL=info
# Directory containing scenario JSON files.
SCENARIOS_DIR=./scenarios
# Lobby list refresh interval in milliseconds.
LOBBY_POLL_INTERVAL_MS=3000

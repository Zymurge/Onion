        "**/playwright-report/**": true,
        "**/test-results/**": true
    },
    "search.exclude": {
        "dist": true
    },
    "chat.tools.compressOutput.enabled": true,
    "chat.tools.terminal.autoApprove": {
        "pnpm": true,
        "npx vitest": true,
        "npx tsc": true,
        "git fetch": true,
        "git commit": true,
        "git worktree": true,
        "git checkout": true,
        "git merge": true,
        "git -C /home/zymurge/Dev/onion": true,
        "docker compose": true,
        "docker exec": true,
        "set": true,
        "printf": true,
        "tee": true,
        "awk": true
